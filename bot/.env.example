DISCORD_TOKEN=
CLIENT_ID=
# Optional: set this during development to deploy slash commands to a single
# guild instantly. Leave blank to deploy globally (can take up to an hour).
GUILD_ID=
# Optional, one-time use: if you used a different GUILD_ID in the past and
# have since changed or removed it, set this to that OLD guild ID once to
# wipe its leftover command registration (stops a command like /give from
# showing twice in that server's slash picker). Safe to clear afterward.
CLEANUP_GUILD_ID=

# --- Scaling ---
# Sharding mode. "auto" (default) asks Discord how many shards are needed, so
# a small bot runs exactly one and nothing changes; crossing ~2,500 guilds
# starts a second automatically. Discord REFUSES a single connection above
# 2,500 guilds, so do not turn this off if you are near that.
# Set to "off" to run one bare client with no manager process (saves ~1
# process worth of RAM, fine for a few hundred guilds).
SHARDING=auto
# Pin an exact shard count instead of asking Discord. Leave blank for auto.
SHARD_COUNT=
# Discord.js cache ceilings. Lower them on a small host, raise them if you
# have RAM to spare and want fewer API round-trips.
MEMBER_CACHE_MAX=200
USER_CACHE_MAX=200
MESSAGE_CACHE_MAX=50
# How many guild configs to keep in memory, and how long an untouched one
# survives before the idle sweep drops it.
CONFIG_CACHE_MAX=2000
CONFIG_CACHE_IDLE_MS=300000
